# Words of NeTEx for the fuzz targets, as libFuzzer reads a dictionary
# (`-dict=fuzz/netex.dict`): the elements and values of the forms the reader
# and the index read by their lexis — day offsets, durations, dates and
# bounds, day bits, multilingual names, versions —, so that the fuzzer
# reaches their edges rather than guessing the names.

frame_composite="<CompositeFrame id=\"c\" version=\"1\"><frames>"
frame_service="<ServiceFrame id=\"s\" version=\"1\">"
frame_timetable="<TimetableFrame id=\"t\" version=\"1\">"
frame_calendar="<ServiceCalendarFrame id=\"k\" version=\"1\">"
valid_between="<ValidBetween><FromDate>2026-10-01T00:00:00</FromDate><ToDate>2026-10-31T23:59:59</ToDate></ValidBetween>"
validity_conditions="<validityConditions>"
from_date="<FromDate>"
to_date="<ToDate>"
utc_midnight="T22:00:00Z"
end_of_day="T23:59:59+01:00"
leap_day="2024-02-29"
no_such_day="2026-02-30"
far_year="9999-12-31"
bits="<ValidDayBits>"
bits_value="1010101"
departure_day_offset="<DepartureDayOffset>"
arrival_day_offset="<ArrivalDayOffset>"
day_offset="<DayOffset>"
huge_offset="106751991167301"
negative_offset="-1"
run_time="<RunTime>"
wait_time="<WaitTime>"
default_duration="<DefaultDuration>"
duration="PT1H30M"
duration_days="P1DT2H"
duration_fraction="PT0.5S"
duration_huge="P999999999999999D"
name_texts="<Name><Text>"
text_lang="<Text lang=\"en\">"
transport_mode="<TransportMode>"
mode_other="other"
version_any="version=\"any\""
version_text="version=\"2.0\""
quay_ref="<QuayRef ref=\""
stop_place_ref="<StopPlaceRef ref=\""
level_ref="<LevelRef ref=\""
